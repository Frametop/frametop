#!/usr/bin/python3
"""fake-viewer: ft-screens' side of one remote display, headless, for verify-frametop stream.

  fake-viewer FT-STREAM HOST CLIENT APP WxH FPS KBPS SECONDS OUT [LOCK]

Runs inside the Frametop container (verify-frametop starts it through scripts/in-box), because
ft-stream's converter needs the container's Mesa: on the host it can't import a decoder buffer
(EGL 0x3009). It starts `FT-STREAM stream HOST --id CLIENT --fd N ...` on a SOCK_SEQPACKET socket
pair as ft-screens does (screens/remote.c), hands every ring buffer back as soon as it's shown,
and after SECONDS (or once the stream is lost) closes its end, which ends ft-stream. In OUT:
ft-stream.log (its own output), viewer.json (pids while it runs) and result.json (states, frames,
frames per second each 10 s and after the first frame, the exit status).

With LOCK (the host's input lock, $XDG_RUNTIME_DIR/frametop-input-HOST.lock), it holds that lock
from before ft-stream starts, and ft-stream inherits it without knowing, so the lock lasts while
either runs and this stream can't lease the host's keyboard and mouse: ft-stream leases only
from the stream holding it. If the viewer is killed, its end of the socket closes and ft-stream
ends too.
"""
import array
import fcntl
import json
import os
import signal
import socket
import subprocess
import sys
import threading
import time

exe, host, client, app, size, fps, kbps, secs, out = sys.argv[1:10]
secs = float(secs)
result = {'states': [], 'messages': [], 'frames': 0, 'first_frame_s': None, 'fps_each_10s': [],
          'input_lock': False}
keep = ()
if len(sys.argv) > 10:
    lock = os.open(sys.argv[10], os.O_RDWR | os.O_CREAT | os.O_NOFOLLOW, 0o600)
    try:
        fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        with open(os.path.join(out, 'result.json'), 'w') as f:
            json.dump(dict(result, exit=None, error='another stream holds the input lock'), f, indent=2)
        sys.exit(3)
    result['input_lock'] = True
    keep = (lock,)   # ft-stream gets it too, unknown to it: the lock lasts while either of us runs
a, b = socket.socketpair(socket.AF_UNIX, socket.SOCK_SEQPACKET)
log = open(os.path.join(out, 'ft-stream.log'), 'ab', buffering=0)
started = time.time()
p = subprocess.Popen([exe, 'stream', host, '--id', client, '--fd', str(b.fileno()), '--app', app, '--size',
                      size, '--fps', fps, '--bitrate', kbps], pass_fds=(b.fileno(), *keep), stdout=log,
                     stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL)
b.close()
with open(os.path.join(out, 'viewer.json'), 'w') as f:
    json.dump({'viewer': os.getpid(), 'ft_stream': p.pid}, f)

stop = threading.Event()
signal.signal(signal.SIGTERM, lambda *_: stop.set())
signal.signal(signal.SIGINT, lambda *_: stop.set())
a.send(b'modifiers 0')   # linear: the converter needs no SteamVR to pick one
a.send(b'attention view')
a.settimeout(0.5)
window, window_start = 0, time.time()
while not stop.is_set() and time.time() < started + secs and p.poll() is None:
    try:
        fds = array.array('i')
        msg, anc, _, _ = a.recvmsg(4096, socket.CMSG_SPACE(16 * fds.itemsize))
    except socket.timeout:
        msg, anc = None, []
    except OSError:
        break
    for level, kind, data in anc:
        if level == socket.SOL_SOCKET and kind == socket.SCM_RIGHTS:
            fds.frombytes(data[:len(data) - len(data) % fds.itemsize])
            for fd in fds:
                os.close(fd)   # the ring's dmabufs: nothing here draws them
    if msg == b'':
        break
    if msg:
        text = msg.decode(errors='replace')
        at = round(time.time() - started, 3)
        if text.startswith('frame '):
            result['frames'] += 1
            window += 1
            if result['first_frame_s'] is None:
                result['first_frame_s'] = at
            try:
                a.send(b'release ' + text.split()[1].encode())
            except OSError:
                break   # ft-stream has gone
        elif text.startswith('state '):
            result['states'].append([at, text[6:]])
            if text.startswith('state lost'):
                break
        elif len(result['messages']) < 50:
            result['messages'].append([at, text])
    if time.time() - window_start >= 10:
        result['fps_each_10s'].append(round(window / (time.time() - window_start), 1))
        window, window_start = 0, time.time()
a.close()   # ft-stream ends when its viewer goes, as when ft-screens stops a remote display
try:
    p.wait(15)
except subprocess.TimeoutExpired:
    p.terminate()
    try:
        p.wait(5)
    except subprocess.TimeoutExpired:
        p.kill()
        p.wait()
ended = time.time()
if result['first_frame_s'] is not None and ended - started > result['first_frame_s'] + 1:
    result['fps_after_first_frame'] = round(result['frames'] / (ended - started - result['first_frame_s']), 1)
result.update(exit=p.returncode, seconds=round(ended - started, 1))
with open(os.path.join(out, 'result.json'), 'w') as f:
    json.dump(result, f, indent=2)
