#!/usr/bin/python3
"""mic-latency: how long the Frame's microphone takes to reach a host, from mic-bursts' log and
the host's recording of its virtual microphone.

  mic-latency BURSTS RECORDING --offset-ms MS [--start UNIX-SECONDS]

BURSTS is the bursts.txt `verify-frametop stream --mic-bursts` left: the Frame's wall time each
burst was due to play into the source ft-stream recorded. RECORDING is the host's recording (any
format ffmpeg reads), whose first sample was taken at host wall time --start; without --start,
that comes from its packets' wall-clock times (ffmpeg -use_wallclock_as_timestamps 1 -t SECONDS
-i ... -copyts writes them; an output -t there ends the recording at once). --offset-ms is the host's clock minus the Frame's. Each burst heard in the recording (a
rise out of half a second of quiet) is matched to the burst played up to 0.9 s before it: with
bursts a second apart, a latency over that can't be measured, and shows as missed bursts.
Prints JSON: matched and missed bursts and the latency's median, spread and drift over the test.
Needs ffmpeg and ffprobe.
"""
import argparse
import array
import json
import statistics
import subprocess
import sys

RATE, WINDOW = 48000, 48   # 1 ms envelope windows
QUIET_S, MAX_LATENCY_S = 0.5, 0.9   # bursts come a second apart: a later one can't be told from the next


def decode(path):
    """The recording's samples in order, mono 48 kHz. Its timestamps are rewritten to the sample
    count first: wall-clock ones jitter, and ffmpeg drops a packet whose time goes back."""
    raw = subprocess.run(['ffmpeg', '-v', 'error', '-i', path, '-map', '0:a:0', '-af', 'asetpts=N/SR/TB', '-ac', '1',
                          '-ar', str(RATE), '-f', 's16le', '-'], capture_output=True, check=True).stdout
    samples = array.array('h')
    samples.frombytes(raw[:len(raw) - len(raw) % 2])
    return samples


def start_time(path):
    """The host wall time of the recording's first sample, from its packets' wall-clock times, or
    0 if it has none. A packet's time is when it arrived, after its last sample was taken, so the
    first sample came at most that time less the audio up to there; the packet that arrived soonest
    bounds it closest."""
    out = subprocess.run(['ffprobe', '-v', 'error', '-select_streams', 'a:0', '-show_entries',
                          'packet=pts_time,duration_time', '-of', 'csv=p=0', path],
                         capture_output=True, text=True, check=True).stdout
    best, audio = None, 0.0
    for line in out.split():
        try:
            pts, duration = (float(x) for x in line.split(',')[:2])
        except ValueError:
            continue   # N/A: no times (a WAV)
        audio += duration
        best = pts - audio if best is None else min(best, pts - audio)
    return best or 0


def onsets(samples):
    """Offsets (s) where a burst starts: the first 1 ms window over the threshold after QUIET_S
    of windows under it."""
    env = [max(abs(min(samples[i:i + WINDOW])), max(samples[i:i + WINDOW]))
           for i in range(0, len(samples) - WINDOW + 1, WINDOW)]
    if not env:
        return []
    floor, peak = statistics.median(env), max(env)
    threshold = max(5 * floor, 0.1 * peak, 300)
    found, quiet = [], int(QUIET_S * 1000)
    for i, level in enumerate(env):
        if level >= threshold:
            if quiet >= QUIET_S * 1000:
                found.append(i * WINDOW / RATE)
            quiet = 0
        else:
            quiet += 1
    return found


def match(played, heard):
    """[(played, heard)] pairs: each heard burst with the latest one played up to MAX_LATENCY_S
    before it, each played burst used once."""
    pairs, used = [], set()
    for t in heard:
        candidates = [p for p in played if 0 <= t - p <= MAX_LATENCY_S and p not in used]
        if candidates:
            used.add(max(candidates))
            pairs.append((max(candidates), t))
    return pairs


def report(played, heard):
    pairs = match(played, heard)
    lat = [(h - p) * 1000 for p, h in pairs]
    result = {'played': len(played), 'heard': len(heard), 'matched': len(pairs),
              'missed': len(played) - len(pairs), 'unmatched_heard': len(heard) - len(pairs)}
    if lat:
        q = statistics.quantiles(lat, n=10) if len(lat) >= 2 else [lat[0]] * 9
        result['latency_ms'] = {'median': round(statistics.median(lat), 1), 'p10': round(q[0], 1),
                                'p90': round(q[-1], 1), 'min': round(min(lat), 1), 'max': round(max(lat), 1)}
        if len(pairs) >= 10:   # ms of latency gained per minute: a growing queue or clock drift
            third = len(lat) // 3
            span = (statistics.mean(p for p, _ in pairs[-third:]) - statistics.mean(p for p, _ in pairs[:third])) / 60
            if span > 0:
                result['latency_ms']['drift_per_min'] = round(
                    (statistics.median(lat[-third:]) - statistics.median(lat[:third])) / span, 1)
    return result


def main(argv):
    ap = argparse.ArgumentParser(prog='mic-latency', description=__doc__.split('\n\n')[0])
    ap.add_argument('bursts')
    ap.add_argument('recording')
    ap.add_argument('--offset-ms', type=float, required=True, help="host clock minus the Frame's")
    ap.add_argument('--start', type=float, help="the recording's first sample, host wall time")
    args = ap.parse_args(argv)
    with open(args.bursts) as f:
        played = [float(line) for line in f if line.strip()]
    start = args.start if args.start is not None else start_time(args.recording)
    if start < 1e9:
        sys.exit('mic-latency: the recording has no wall-clock start time: pass --start')
    begin = start - args.offset_ms / 1000   # the first sample, on the Frame's clock
    heard = [begin + t for t in onsets(decode(args.recording))]
    print(json.dumps(dict(report(played, heard), offset_ms=args.offset_ms), indent=2))
    return 0


if __name__ == '__main__':
    sys.exit(main(sys.argv[1:]))
