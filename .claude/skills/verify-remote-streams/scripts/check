#!/usr/bin/env python3
"""Model-check the remote stream and host-input lease models (docs/charts/remote-streams/*.tla) with TLC, one run per
model and invariant, and compare with the recorded baseline (BASELINE below).

  check [--model DIR]     exit 0: every result matches the baseline
                          exit 1: a result differs (a new break, or a known finding now holds)
                          exit 2: TLC couldn't run

TLC 1.7.4 comes from TLA2TOOLS (a tla2tools.jar path) or is downloaded once into
~/.cache/frametop-formal and checked against its SHA-256. Java comes from JAVA, then `java` on
PATH, then mise's java@temurin-25."""
import hashlib, os, re, shutil, subprocess, sys, tempfile, urllib.request
from pathlib import Path

HERE = Path(__file__).resolve().parent.parent
MODEL = HERE.parents[2] / 'docs/charts/remote-streams'  # the models live with the other charts
TLC_URL = 'https://github.com/tlaplus/tlaplus/releases/download/v1.7.4/tla2tools.jar'
TLC_SHA256 = '936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88'
MODELS = {
    'HostInputLease': ['TypeOK', 'AwayGivesBack', 'NoStaleLease', 'OffOnLiftsEscape', 'EscapeNeedsOff'],
    'RemoteStreams': ['TypeOK', 'OneStreamPerDisplay', 'OneHostOperation', 'StoppedStaysStopped', 'NeverStranded'],
}
# What the code at the sync commit does (SKILL.md, Findings): 'holds', or the finding's name and
# TLC's shortest path to it (one worker, so the same model gives the same path). A known rule
# that breaks by another shortest path is a new way to break it, so it differs too.
# H1 broke NoStaleLease by this path until answers counted from when they were given (GivenAt).
H1 = 'StreamStarts SwitchOff StreamLive TickLive HelperAnswers HeadsetOff ReadSwitch Age SwitchOn ReadSwitch TickLive'
# H2 broke OffOnLiftsEscape by this path until the escape was kept for the next stream (the
# marker) and the pointer helper said when the headset last went back on (on-at).
H2 = ('StreamStarts StreamLive TickLive HelperAnswers HeadsetOff TickLive HostEscape StreamEnds StreamStarts Age HeadsetOn'
      ' StreamLive TickLive HelperAnswers TickLive')
# R1 broke OneStreamPerDisplay and OneHostOperation by this path until host_busy counted
# a stream on its way out.
R1 = 'YouStart TickStarts YouStop YouStart TickStarts'
# Every rule not listed holds.
BASELINE = {}


def tla2tools():
    if os.environ.get('TLA2TOOLS'):
        return os.environ['TLA2TOOLS']
    jar = Path.home() / '.cache/frametop-formal/tla2tools-1.7.4.jar'
    if not jar.exists():
        jar.parent.mkdir(parents=True, exist_ok=True)
        data = urllib.request.urlopen(TLC_URL, timeout=120).read()
        if hashlib.sha256(data).hexdigest() != TLC_SHA256:
            sys.exit(f'check: {TLC_URL} does not match its SHA-256')
        jar.write_bytes(data)
    return str(jar)


def java():
    if os.environ.get('JAVA'):
        return os.environ['JAVA']
    if shutil.which('java'):
        return 'java'
    if shutil.which('mise'):
        found = subprocess.run(['mise', 'which', 'java', '--tool', 'java@temurin-25'], capture_output=True, text=True)
        if found.returncode:
            subprocess.run(['mise', 'install', 'java@temurin-25'], check=True)
            found = subprocess.run(['mise', 'which', 'java', '--tool', 'java@temurin-25'], capture_output=True, text=True)
        if found.returncode == 0:
            return found.stdout.strip()
    sys.exit('check: no Java: set JAVA, put java 11+ on PATH, or install mise')


def run(jar, jvm, model, spec, rule, work):
    cfg = Path(model, spec + '.cfg').read_text()
    cfg = re.sub(r'^INVARIANT .*\n', '', cfg, flags=re.M) + f'INVARIANT {rule}\n'
    Path(work, 'run.cfg').write_text(cfg)
    out = subprocess.run([jvm, '-XX:+UseParallelGC', '-cp', jar, 'tlc2.TLC', '-workers', '1', '-deadlock',
                          '-metadir', str(Path(work, 'meta')), '-config', 'run.cfg', spec + '.tla'],
                         cwd=work, capture_output=True, text=True, timeout=600).stdout
    if f'Invariant {rule} is violated' in out:
        steps = re.findall(r'^State \d+: <(\w+)', out, re.M)
        return 'breaks', ' '.join(s for s in steps if s != 'Initial')
    if 'No error has been found' in out:
        return 'holds', ''
    sys.stderr.write(out[-3000:])
    sys.exit(f'check: TLC failed on {spec}/{rule}')


def main():
    model = Path(sys.argv[sys.argv.index('--model') + 1]) if '--model' in sys.argv else MODEL
    jar, jvm = tla2tools(), java()
    differs = 0
    with tempfile.TemporaryDirectory(prefix='remote-streams-check-') as work:
        for spec, rules in MODELS.items():
            shutil.copy(Path(model, spec + '.tla'), work)
            for rule in rules:
                got, steps = run(jar, jvm, model, spec, rule, work)
                want = BASELINE.get((spec, rule), 'holds')
                ok = got == want if want == 'holds' else (got == 'breaks' and steps == want[1])
                differs += not ok
                note = '' if want == 'holds' else f' (known finding {want[0]})' if ok else f' (known finding {want[0]}, by another path)'
                print(f"{'ok  ' if ok else 'DIFF'} {spec:14} {rule:19} {got}{note if got == 'breaks' else ''}")
                if steps:
                    print('       shortest path: ' + steps.replace(' ', ' -> '))
    print('matches the baseline' if not differs else f'{differs} result(s) differ from the baseline: see SKILL.md')
    return 1 if differs else 0


if __name__ == '__main__':
    sys.exit(main())
