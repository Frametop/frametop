#!/usr/bin/env python3
"""Replay the models' shortest paths against the real code, offline, and compare with the baseline.

  replay [REPO]     REPO defaults to the checkout this skill sits in
                    exit 0: every finding behaves as recorded (BASELINE below)
                    exit 1: a finding changed (fixed, or a control now breaks)
                    exit 2: the harness couldn't build or run

H1, H2 and the H2 control build ft-stream's real struct HostInput (copied out of stream/ft-stream.cpp, with the
relay's and the pointer helper's socket names swapped for this run's own) next to a fake helper
and relay, and record every lease it sends. R1 builds the real screens/remote.c with SteamVR
stubbed and a fake ft-stream that takes 1 s to exit after SIGTERM. Nothing reaches the live relay,
helper, desktop or any Vibepollo host. Builds and runs happen in the `dev` podman container, in a
fresh /tmp directory that is removed afterwards (keep it with KEEP=1)."""
import os, re, shutil, subprocess, sys, tempfile
from pathlib import Path

HERE = Path(__file__).resolve().parent
SRC = HERE / 'replay-src'
# True: the finding happens in the code at the sync commit (SKILL.md, Findings). All three are
# fixed. H1 (answers count from when they were given): its path must no longer lease. H2 (the
# escape kept for the next stream, the helper's on-at): an off-on with no stream to see it must
# lift the escape before the next lease. R1 (host_busy waits for a stream on its way out): a stop
# and a start must no longer overlap. The controls must not happen either: H2-control is a Wi-Fi
# drop with the headset on, which must keep the escape; R1-control the in-place settings change,
# which waits for the old stream.
BASELINE = {'H1': False, 'H2': False, 'H2-control': False, 'R1': False, 'R1-control': False}


def cpus():
    """CPUs for the container's work: podman exec runs outside frame-job's cgroup, so it gets pinned
    to as many as frame-job's local cap allows (1 while the headset is worn)."""
    status = subprocess.run(['frame-job', '--status'], capture_output=True, text=True).stdout if shutil.which('frame-job') else ''
    m = re.search(r'local cap (\d+)%', status)
    n = max(1, int(m.group(1)) // 100) if m else 1
    return '0' if n == 1 else f'0-{n - 1}'


CPUS = None


def sh(work, *cmd, env=None):
    global CPUS
    CPUS = CPUS or cpus()
    pre = ['podman', 'exec', '--user', str(os.getuid()), '-w', str(work)]  # our uid: the files stay removable
    for k, v in (env or {}).items():
        pre += ['-e', f'{k}={v}']
    return subprocess.run(pre + ['dev', 'taskset', '-c', CPUS, *cmd], capture_output=True, text=True, timeout=120)


def build(work, repo):
    tag = str(os.getpid())
    for f in SRC.iterdir():
        Path(work, f.name).write_text(f.read_text().replace('@WORK@', str(work)).replace('@TAG@', tag))
    os.chmod(Path(work, 'fake-ft-stream'), 0o755)
    subprocess.run([sys.executable, '-I', str(Path(work, 'extract.py')), str(repo / 'stream/ft-stream.cpp'),
                    str(Path(work, 'hostin_struct.inc')), tag], check=True)
    steps = [['g++', '-std=c++17', '-O0', '-Wall', f'-I{repo}/stream', '-o', 'hostin-repro', 'hostin-repro.cpp'],
             ['gcc', '-std=gnu11', '-O0', '-Wall', '-DWLR_USE_UNSTABLE', f'-I{repo}/screens',
              '-I/usr/include/wlroots-0.20', '-I/usr/include/libdrm', '-I/usr/include/pixman-1',
              '-o', 'remote-repro', 'remote-repro.c', f'{repo}/screens/remote.c', '-lwlroots-0.20', '-lwayland-server']]
    for cmd in steps:
        out = sh(work, *cmd)
        if out.returncode:
            sys.stderr.write(out.stdout + out.stderr)
            sys.exit(f'replay: {cmd[0]} failed (did HostInput or remote.c change shape? see SKILL.md)')


def host(work):
    out = sh(work, './hostin-repro')
    verdicts = re.findall(r'^  => (REPRODUCED|not reproduced)', out.stdout, re.M)
    if len(verdicts) != 3:
        sys.stderr.write(out.stdout + out.stderr)
        sys.exit('replay: the HostInput harness did not finish its three paths')
    return {'H1': verdicts[0] == 'REPRODUCED', 'H2': verdicts[1] == 'REPRODUCED',
            'H2-control': verdicts[2] == 'REPRODUCED'}, out.stdout


def remote(work, mode):
    log = Path(work, 'rs-events.log')
    log.unlink(missing_ok=True)
    rt = Path(work, 'rt'); rt.mkdir(exist_ok=True)
    out = sh(work, './remote-repro', mode, env={'FT_STREAM': f'{work}/fake-ft-stream', 'XDG_RUNTIME_DIR': str(rt)})
    if out.returncode or not log.exists():
        sys.stderr.write(out.stdout + out.stderr)
        sys.exit(f'replay: the remote.c harness failed ({mode})')
    text = log.read_text()
    starts = [(float(t), p) for t, p in re.findall(r'^(\S+) start pid=(\d+)', text, re.M)]
    exits = {p: float(t) for t, p in re.findall(r'^(\S+) exit pid=(\d+)', text, re.M)}
    if len(starts) < 2:
        sys.exit(f'replay: the remote.c harness started {len(starts)} stream(s) in {mode}, wanted 2')
    (_, first), (second_at, _) = starts[0], starts[1]
    # Two ft-streams for one display: the second started before the first had gone.
    return second_at < exits.get(first, float('inf')), text


def main():
    repo = Path(sys.argv[1]).resolve() if len(sys.argv) > 1 else HERE.parents[3]
    if subprocess.run(['podman', 'exec', 'dev', 'true'], capture_output=True).returncode:
        sys.exit('replay: the dev container is not running (podman start dev)')
    work = Path(tempfile.mkdtemp(prefix='ftsc-replay-', dir='/tmp'))
    try:
        build(work, repo)
        got, host_log = host(work)
        got['R1'], stop_log = remote(work, 'stop-start')
        got['R1-control'], set_log = remote(work, 'new-settings')
        if os.environ.get('VERBOSE'):
            print(host_log, stop_log, set_log, sep='\n')
    finally:
        if not os.environ.get('KEEP'):
            shutil.rmtree(work, ignore_errors=True)
        else:
            print(f'kept {work}')
    differs = 0
    for k, want in BASELINE.items():
        ok = got[k] == want
        differs += not ok
        print(f"{'ok  ' if ok else 'DIFF'} {k:11} {'happens' if got[k] else 'does not happen'}"
              f"{'' if ok else ' (baseline: ' + ('happens' if want else 'does not happen') + ')'}")
    print('matches the baseline' if not differs else f'{differs} result(s) differ from the baseline: see SKILL.md')
    return 1 if differs else 0


if __name__ == '__main__':
    sys.exit(main())
