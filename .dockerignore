# Keep the build context small: what .gitignore ignores, and regenerated files.
# Unlike .gitignore, patterns here only match at the top unless they start
# with **/, so the ones that can appear in any folder do.
.git/
.worktrees/
.venv/
**/build/
**/target/
**/captures/
**/__pycache__/
**/*.pyc
# Eye-camera frame dumps are biometric (see .gitignore): never in an image.
**/*.raw
**/*.pgm
**/.env
**/.env.*
frametop-report-*.txt
.frame-job.d/
# the fine-tuned hand models: the image fetches its own pinned copy (hands/models.sh)
hands/models/student/
hands/models/.student-*
# model versions downloaded from Input Settings (models/catalog.py): each install fetches its own
hands/models/versions/
gaze/tracker/models/
# dev-only: the testbench and the agents' verification skill never ship (testbench/README.md)
testbench/
.claude/
# dev-only: fast-install puts commits into an installed release (AGENTS.md)
scripts/fast-install*
