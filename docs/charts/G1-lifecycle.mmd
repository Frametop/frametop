  state "SteamVR and the units (systemd)" as sv {
    s1: SteamVR off: input relay up (Before=steamvr), helper, gaze, ft-powerd down
    [*] --> s1
    s2: SteamVR starting: helper starting, frametop-gaze + ft-powerd up
    s3: SteamVR up: the helper said vrhello
    s4: SteamVR off, camd + hands running (no Requisite=steamvr)
  }
  state "frametop-gaze unit (Requisite=steamvr, Restart)" as gz {
    g1: Down
    [*] --> g1
    g2: Running
    g3: ft-gazed crashed: systemd restarts it in 3 s
    g4: Running again while Frametop is paused
  }
  state "Input relay (input-relay.py) and the helper's 3D pointer" as rl {
    r1: Relay up, no pointer held
    [*] --> r1
    r2: Relay up, holds the 3D pointer
    r3: Relay down, the helper keeps the pointer
    r4: Relay down, nothing held, queued jobs gone
    r5: Relay up again: the helper holds the pointer, the new relay thinks not (active=False)
  }
  state "Pause for VR games (game_pause.py, pause.json)" as ps {
    p0: Not paused
    [*] --> p0
    p1: Paused, the pause job queued: units still running
    p2: Paused: gaze, hands, camd stopped (stopped list in memory)
    p3: Paused for a game (vrgame 1): units stopped
    p4: Game ended: resume in 5 s
    p5: Resume queued: pause.json already says paused=false
    p6: Resume queued behind a late pause job: units stopped
    p7: Not paused, stopped list lost: gaze off, a closed desktop stays closed
    p8: Paused, the game gone, the new relay thinks no game: stuck
  }
  state "Desktop session (frametop-desktop, ft-screens, frametop-session.sh)" as dk {
    d0: No desktop
    [*] --> d0
    d1: Starting: autostart.sh waits for vrserver + 5 s, then desktops.sh start
    d2: Desktop up, shown: handsmode up started camd + hands
    d3: Desktop up, hidden ("pause on", sticky in ft-screens)
    d4: Closed by the pause (close mode), on the stopped list
    d6: Desktop up during a pause, not hidden yet
    d5: Desktop hidden, camd + hands running during the pause
  }
  state "Worn: the pointer helper vs ft-powerd (both read SteamVR's activity level)" as wn {
    w0: On a head: both say worn
    [*] --> w0
    w1: Off under 1 s: both still say worn
    w2: Off 1 to 1.5 s: ft-powerd says away, the helper still worn
    w3: Off 1.5 s or more: both away
    w4: Back on under 1 s: the helper says worn, ft-powerd still away
    w5: Off 5 s: SteamVR standby
  }
  state "Display power (ft-powerd)" as dp {
    x0: Displays on
    [*] --> x0
    x1: Dark by ft-powerd, brightness saved to powerd-brightness
    x2: Dark by SteamVR standby
  }
  state "Other groups" as og {
    o2: G2 Desktop and panels
    o3: G3 Input and pointer
    o4: G4 Gaze
    o5: G5 Hands
    o6: G6 Remote displays and host input
  }
  sv --> gz: SteamVR starts and stops frametop-gaze
  sv --> rl: the helper's vrhello and vrgame reach the relay
  rl --> ps: the relay runs the pause worker
  ps --> dk: pause hides or closes the desktop
  wn --> dp: ft-powerd's away starts the display timeout
  s1 --> s2: (L1.1 L2.1 L3.3 L4.1 L5.3 L6.1) SteamVR starts
  s2 --> s3: (L1.2 L2.2 L4.2 L5.4 L6.3) vrhello: the relay enforces a pause again
  s2 --> s1: (L3.6) SteamVR stops before vrhello
  s3 --> s1: SteamVR stops: Requisite units + the desktop go, ft-powerd turns displays on
  s1 --> s4: (L3.7) the resume job starts camd + hands anyway
  s4 --> s2: SteamVR starts
  g1 --> g2: SteamVR starts, or a resume restarts it
  g2 --> g1: the pause job stops it, or SteamVR stops
  g2 --> g3: (L4.4) ft-gazed crashes
  g3 --> g2: systemd restarts it, not paused
  g3 --> g4: (L4.5 L4.6) the pause job skips it (is-active), systemd restarts it 3 s later
  g4 --> g1: the next vrhello or pause enforces again
  r1 --> r2: (L1.3) you move the 3D mouse
  r2 --> r1: pause, idle, or headset off: the relay lets go
  r2 --> r3: (L1.4) the relay crashes
  r3 --> r5: (L1.5) systemd restarts it in 1 s: a new Pointer
  r1 --> r4: (L5.6 L6.6) the relay crashes
  r4 --> r1: (L5.7 L6.7) systemd restarts it: load reads pause.json
  r5 --> r1: a controller moves, or the headset comes off
  p0 --> p1: (L1.6 L2.3 L3.1 L4.3 L5.1) you pause (ft-pause, both sticks twice)
  p0 --> p3: (L6.2 L6.4) you start a game: the helper says vrgame 1
  p1 --> p2: (L2.4 L4.5) the pause job runs stop_units (active units only)
  p1 --> p5: (L3.2 L5.2) you resume before the pause job ran
  p2 --> p5: you resume: save writes paused=false
  p3 --> p4: the helper says vrgame 0 (sent every 5 s)
  p4 --> p3: a game starts again
  p4 --> p5: 5 s pass (RESUME_DELAY)
  p5 --> p0: the resume job restarts the stopped list
  p5 --> p6: (L3.5 L5.5) the late pause job runs first, stops units
  p6 --> p0: (L3.7) the resume job restarts camd + hands, SteamVR or not
  p6 --> p7: (L5.6 L5.7) the relay restarts: load skips a paused=false file
  p7 --> p0: the next pause + resume, or SteamVR and the desktop restart
  p3 --> p8: (L6.5 L6.6 L6.7 L6.8) the game ends while the relay restarts: load sets game False
  p8 --> p0: you resume, or the next game ends
  d0 --> d1: (L2.1 L3.3) SteamVR starts with AUTOSTART=1, or desktops.sh start
  d1 --> d2: (L3.4) ft-screens' socket appears: handsmode up
  d1 --> d6: (L2.5) it comes up during a pause: handsmode up, no pause check
  d6 --> d5: (L2.6) the relay sees the screens: "pause on" hides them, hands keep running
  d5 --> d2: resume: "pause off"
  d2 --> d3: pause, hide mode: the relay sends "pause on"
  d3 --> d2: resume: one "pause off" datagram (L7)
  d2 --> d4: pause, close mode: desktops.sh stop, handsmode down
  d4 --> d1: resume with SteamVR up: desktops.sh start
  d2 --> d0: SteamVR stops (ft-screens exits on VREvent_Quit), or desktops.sh stop
  d3 --> d0: SteamVR stops
  w0 --> w1: you take the headset off
  w1 --> w0: you put it back on
  w1 --> w2: 1 s: ft-powerd's debounce
  w2 --> w3: 0.5 s more: the helper's HEADSET_OFF_AFTER
  w2 --> w4: you put it back on
  w3 --> w4: you put it back on
  w3 --> w5: 5 s off: standby, the helper says away at once
  w5 --> w4: you put it back on
  w4 --> w0: 1 s: ft-powerd says worn again
  x0 --> x1: away for DISPLAY_OFF_MIN (default 0 = never)
  x1 --> x0: you use it, the headset goes on, or ft-powerd stops (turnOn)
  x0 --> x2: standby (headset off 5 s)
  x2 --> x0: you put the headset on
  w3 --> r1: away: the helper lets go of the pointer
  p1 --> o3: G3: pause_changed, stand_down, gamepad.stop, pointer None
  p2 --> o4: G4: frametop-gaze stops, resume restarts it
  p2 --> o5: G5: camd + hands stop (kept with hand interaction on)
  d2 --> o5: G5: handsmode up / down with the desktop
  d3 --> o2: G2: "pause on" hides every panel
  d4 --> o2: G2: close mode stops frametop-desktop
  d0 --> o6: G6: remote streams end with the desktop
  w3 --> o6: G6: ft-stream reads "away", stops leasing
  w3 --> o3: G3: the 3D pointer is let go
  s3 --> o4: G4: frametop-gaze needs SteamVR (Requisite)
