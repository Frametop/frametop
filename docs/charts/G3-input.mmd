  state "Relay: a key from a pass-through keyboard (input-relay.py 2163-2176, apply_roles 1726-1758, G3Keys.tla)" as kr {
    k0: Up
    [*] --> k0
    k1: Down, typing goes to Steam: not grabbed, Steam reads it raw
    k2: Down, typing goes to the desktop: grabbed, to_screens, screens_down has it
    k3: Down with the relay gone: its grab went with it, ft-screens never hears (datagrams)
    k4: Up, a new relay: it lets go of modifiers and mouse buttons only, screens_down is empty
  }
  state "ft-screens: where a key goes (screens/compositor.c handle_key 948-978, held-keys.h)" as fs {
    s0: Nothing down
    [*] --> s0
    s1: KWin has it down (the seat's key_held)
    s2: Released with no screen focused: owed to KWin (lost_keys, 40)
    s3: A remote display has it (key_remote, ft_remote_key)
    s4: Frunner's search has it (spot_send)
    s5: Stuck in KWin: nobody left knows, it repeats
  }
  state "Relay: a pointer-role mouse button (input-relay.py 2178-2194, Pointer.action 867-893)" as pb {
    b0: Up
    [*] --> b0
    b1: Down in pointer mode: the helper's btn trigger 1, driver_down
    b2: Down, paused or POINTER=0: the virtual mouse has it (node.held)
    b7: Down, stood down: pause_changed's stand_down let the driver go
    b8: Down, pointer mode back: the virtual mouse still has it
    b9: Down, POINTER=0: the Pointer dropped with no stand_down
    b5: Down with the relay gone
    b3: Up, the virtual mouse still down
    b4: Up, the helper's leftHeld and the driver's trigger still down
  }
  state "Pointer helper: who drives the laser (ft-pointer.cpp, rayowner.h, handoff.h, G3Laser.tla)" as lo {
    l0: Asleep: the virtual controller hidden, the laser SteamVR's
    [*] --> l0
    l1: The mouse drives it, or gaze mode places it
    l2: A hand ray drives it: one owner, 0.5 s grace, the other hand takes it by a pinch or a raise
    l3: A touch on a SteamVR panel poses it (ft-screens touch): nothing else poses it
    l4: That hand's controller has it (handoff: a touch, press or move), its ray left at once
  }
  state "The laser's one trigger (driver_ft_pointer.cpp state_.buttons, G3Laser.tla 302 states)" as tr {
    t0: Up
    [*] --> t0
    t1: Down for one holder: a touch, a ray pinch, or the mouse (pressLeft)
    t2: Two holders on one trigger and one leftHeld
    t3: Up while a holder still holds it
    t4: Down, the pointer let go of with the touch holding it
    t5: Down with no holder: hide keeps it, the next wake connects it pressed
  }
  state "Keyboards (ft-textinput, ft-screens' key panel, Full Keyboard)" as kb {
    y0: No keyboard
    [*] --> y0
    y1: A text field has focus: Frametop's key panel is up (vrkeyboard show)
    y2: Full Keyboard holds a key: kb_held says desktop or Steam
  }
  state "Voice typing (voice/ft-voiced, the relay's typing queue 1518-1600)" as vt {
    v0: Idle
    [*] --> v0
    v1: Listening: dictate toggles, dictate_hold while held, works while paused
    v2: Typing: type TEXT on @frametop_relay, one key at a time, waits while a modifier is held
  }
  state "Gamepad mode (input/vrpad.py)" as gp {
    g0: Off
    [*] --> g0
    g1: For a desktop panel: VirtualPad, an Xbox 360 pad on uinput (fd store)
    g2: For a remote display: pad lines to ft-screens, its ft-stream's Moonlight pad
    g3: Reused after a relay restart: starts NEUTRAL, buttons left down stay down
  }
  state "Other groups" as og {
    o1: G1 Lifecycle and presence
    o2: G2 Desktop and panels
    o4: G4 Gaze
    o5: G5 Hands
    o6: G6 Remote displays and host input
  }
