  state "Gaze sources (gaze/ft-gaze.cpp, sources LIST from ft-gazed's wanted_sources)" as gs {
    q1: mmap1: SteamVR's combined gaze, eye-server.mmap set 1, read-only (EyeFile.Detect: SteamOS 0.3 and 0.4 layouts)
    q2: left and right: each eye's own reading, set 2
    q3: own: our tracker, /dev/shm/frametop-eyes-gaze
    q4: action: SteamVR's gaze action, calls into vrserver, read only while a check runs
    q5: fusion (GAZE_FUSION=on): SteamVR's two eyes through an affine fitted at our dots, half and half with ours
  }
  state "The data path, drawn by hand (ft-gazed's header 1-140, ft-gaze.cpp 740-790)" as dp {
    d1: ft-eyegrab (root, frametop-eyegrab): copies the eye cameras' frames only while /dev/shm/frametop-eyes-want is fresh
    d2: ft-eyes (gaze/tracker, in the dev box): pupils to gaze, its own calibration, touches the want file every second
    d3: ft-gaze: one JSON line per new sample (90 Hz), only with a head pose, only the sources asked for
    d4: ft-gazed: drops blinks, combines the eyes (EyeWeights, EyeBridge), corrects (calibration.json, lessons), fixation lock (GazeLock, 1 deg)
    d5: Pointer helper: gz yaw pitch rawyaw rawpitch on @ft_pointer_helper, used only in gaze mode (POINTER_GAZE)
    d6: Gaze owns the pointer: a fresh gz within 250 ms wakes it (gazewoke), the mouse nudges it
    d7: A nudge and a click: lesson rawyaw rawpitch trueyaw truepitch back to ft-gazed, recheck past POINTER_GAZE_NUDGE_MAX
  }
  state "ft-gazed: idle and wake (ft-gazed 546-584 and 655, G4Gaze.tla)" as iw {
    i0: Idle: ft-gaze and ft-eyes stopped, the frame grabber idle
    [*] --> i0
    i1: Waking: started, WAKE_SETTLE (15 s) for the tracker to send
    i2: Awake: gaze in use (gaze mode on and worn, a check open or asked for, a wake lease)
    i3: Down: ft-gazed died, its children quit with their stdin
  }
  state "The full calibration (gazecheck.py need_full 499-525, start 600-650, finish 1174-1213, G4Gaze.tla)" as fc {
    c0: Not calibrated, armed: need_full opens it once per arming
    [*] --> c0
    c1: Open in the panel, Frametop's screens hidden (ft-screens hide)
    c2: Fitting: ft-eyes has the dots (calib-fit, up to 10 s), EYES_GONE paused
    c3: Saved, closed: ft-gazed still holds ft-eyes' last status (no calibration) for up to a second
    c4: A second full calibration opens on a calibrated tracker
    c5: Closed unfinished, not armed: Not calibrated, use Calibrate
    c6: Calibrated: quick checks when the headset goes on (auto_quick)
    c7: Screens hidden with no calibration open, nobody left to show them
    c8: Waiting for a gaze our tracker can't send before it is calibrated
  }
  state "The calibration panel (ft-gazepanel, calpanel.h, ft-pointer.cpp 2044-2063, vr.cpp 2745 and 6060)" as cp {
    p0: Down: clicks go to the desktop
    [*] --> p0
    p1: Up: calpanel 1 every second to the helper, a 3 s lease, passed on to the relay and ft-screens (no palm menu)
    p2: A click while up: trigger, left, Enter, Meta+J, a pinch, a gaze precision or drag press give calaccept. b, right, Meta+K give calquit
    p3: Lease lapsed: 3 s after the last calpanel 1, the pointer and the palm menu come back
  }
  state "Check headset fit, asked for while idle (run_pending 1293-1305, start_fit 636-640)" as ft {
    f0: Asked for: pending, the tracker wakes
    f1: Waiting for svc.last_sample, a corrected gaze
    f2: Open: start_fit needs only sample_at, any sample
  }
  state "Other groups" as og {
    o1: G1 Lifecycle and presence
    o2: G2 Desktop and panels
    o3: G3 Input and pointer
    o5: G5 Hands
  }
