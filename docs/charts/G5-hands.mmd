  state "The pipeline, drawn by hand (hands/README.md, camd.c, track/main.cpp, handsin.h, handinput.cpp)" as pl {
    a1: XRService: owns the four IR tracking cameras, alternates bright and near-black frames
    a2: ft-camd (host, file caps, drops them after set-up): borrows the DMA-BUFs with pidfd_getfd, follows v4l2_dqbuf, publishes bright frames to cam-ring
    a3: ft-hands (dev box, CPUs 5-7, nice 5): palm search and landmarks on ncnn, side check (sides.h), 3D, skeleton, pinch, grip and middle pinch
    a4: /run/user/UID/frametop-hands: hands (fh_hands.h v2), gestures (fh_gestures.h v3), sides.json, park, hands-want, want-hz, flag
    a5: ft-screens: hand cutouts (handcut.cpp) and near input on its panels (handinput.cpp), writes want-hz 30 near a panel
    a6: Pointer helper: hands into the room (handsin.h), the handoff arbiter, the hand ray, pinches and grips as clicks and drags
    a7: ft-handview: the hands drawn over games and the dashboard with Room View off, skips a hand at a controller
    a8: Hand Recorder and flags: read cam-ring and hands, record without parking
  }
  state "ft-camd and ft-hands come and go (frametop-camd.service, frametop-hands.service)" as cm {
    m0: Not running: SteamVR off, or the mode or session stopped them
    [*] --> m0
    m1: Attached: copying frames, ft-hands tracking at 30, 15 or 5 Hz
    m2: ft-camd exited: XRService restarted, buffers went stale, or a camera stopped 3 s
    m3: Restarting: 1, 1.7, 2.9, then 5 s while SteamVR runs, ft-hands waits up to 15 s for the new ring
  }
  state "When tracking runs and parks (handsmode.py plan 289-318, game_pause.py 543-550 and 701-733, G5Hands.tla)" as tr {
    r0: Off: SteamVR off, or the desktop down with HANDS_MODE=frametop
    [*] --> r0
    r1: Tracking: the desktop up, not paused, or paused with the dashboard open
    r2: Parked: paused for a game with hand interaction on, park written, models loaded, no frames copied
    r3: Stopped by the pause: hand interaction off, on the stopped list, resume starts them
    r4: Tracking through a game: paused, dashboard closed, no park file
    r5: ft-cutouts' units: the same two programs by hand, no gestures, Conflicts= with the tracking units
  }
  state "The relay's park state (update_park 714-733, the helper's vrdash 2594-2597)" as pk {
    k0: Not parked, parked False: not paused, or no hand interaction
    [*] --> k0
    k1: Parked, file written, parked True
    k2: parked True, no file: the folder was missing at the pause
    k3: Unparked for the dashboard: vrdash 1, file removed
    k4: The relay's dashboard copy is wrong: no vrdash since the helper or relay restarted
  }
  state "Hand roles, per side (pointer/helper/handoff.h)" as hr {
    h0: Off: no hand tracking for 1.5 s and no controller in use
    [*] --> h0
    h1: Hand: the bare hand works this side, hands L R allowed to ft-screens and ft-handview
    h2: Controller: a controller used recently, its hand's gestures ignored, no ray
  }
  state "Near input in ft-screens (vr.cpp 2724-2779, handinput.cpp 776-781)" as ni {
    n0: Not allowed: the word says controller or off, older than 3 s, not allowed, paused, or the palm menu has the hand
    [*] --> n0
    n1: Idle or hovering: a poke or a pinch can start
    n2: Pressing or grabbing a panel: a poke, the bar, a corner, a card or a fist carry, two hands
    n3: Held through an off word for up to holdLostMs (not a controller, not paused)
  }
  state "The hand ray and pinches (rayowner.h, ft-pointer.cpp 1545-1590, 3380-3672)" as ry {
    y0: No ray: hand interaction off, a controller, a game, the mouse used within 1 s, or near a panel
    [*] --> y0
    y1: A ray owns the pointer: the first to show, last used wins on a pinch
    y2: The owner's ray down, within the 0.5 s grace: the pointer holds its last pose
    y3: A pinch held: the left button pressed along the aim lock, a tap clicks, a hold drags
    y4: Ended as lost: the hand lost, a grip, the ray off, ft-hands quiet 2.5 s, the pointer went
  }
  state "Other groups" as og {
    o1: G1 Lifecycle and presence
    o2: G2 Desktop and panels
    o3: G3 Input and pointer
    o4: G4 Gaze
    o8: G8 Verification, data and diagnostics
  }
