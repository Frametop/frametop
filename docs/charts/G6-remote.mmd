  state "Desktop stop (desktops.sh stop, ft_remote_shutdown)" as ds {
    d0: Desktop up: ft-screens runs the remote displays
    [*] --> d0
    d1: ft-screens SIGTERMs every ft-stream and exits at once (no wait, no SIGKILL)
    d2: An ft-stream stuck on its way out with ft-screens gone: an orphan in the container
  }
  state "Remote display N in ft-screens (screens/remote.c, G6RemoteExit.tla, 312 states)" as rs {
    q0: Off: no slot
    [*] --> q0
    q1: Queued: a start due, waits while host_busy
    q2: Starting: ft-stream launches on the host
    q3: Live: the panel shows the stream
    q4: Restart due: 2 s, doubling to 30 s
    q5: Asked to end (stop, new settings): quit_at, SIGTERM
    q6: Stuck after a stop: SIGKILL 20 s after quit_at
    q7: The host or network ended it: in LiStopConnection, ft-screens still says live
    q8: Said lost: decoder close, Disconnect Monitor (monitor only)
    q9: Exited, not reaped yet: leaving, host_busy holds the host
    q10: Stuck, still says live: frozen panel, no SIGKILL, the slot never frees
    q11: Stuck after lost: no SIGKILL, every display of the host waits
  }
  state "Host-input lease (ft-stream HostInput, HostInputLease.tla 3,561 states, HostChart 345)" as hl {
    h0: No lease: the computer keeps its keyboard and mouse
    [*] --> h0
    h1: Holds frametop-input-HOST.lock, asks the helper each second
    h5: A worn answer waited unread 3 s or more
    h2: Leasing: engage every 500 ms
    h3: Escaped: the host refuses leases, marker frametop-escape-HOST
    h4: The helper's on-at is after the escape: a release is owed
    h6: The lock held by a stuck ft-stream: no stream of the host can lease
  }
  state "frame-testbench fake-worn guard and flag (FakeWornGuard.tla, Kills 264, NoF 480, All 632 states)" as fw {
    f0: Wearer not faked
    [*] --> f0
    f1: worn on: checking for a live stream or an unconfirmed flag
    f2: Faked: the guard holds every host's input lock, frametop-fake-worn.json says so
    f3: Guard gone, wearer released, the flag left
    f4: A stream holds the freed lock: the flag stops its lease
  }
  state "Input relay network devices (input-relay.py, drawn from the code)" as nd {
    n0: No host device
    [*] --> n0
    n1: The host's keyboard and mouse as nodes (bus network), roles apply
  }
  state "Other groups" as og {
    o1: G1 Lifecycle and presence
    o3: G3 Input and pointer
    o8: G8 Verification
  }
  ds --> rs: the desktop owns every slot
  rs --> hl: each live stream runs the lease
  fw --> hl: the flag is read every tick
  hl --> nd: the host's events come back
  d0 --> d1: (R4.1) desktops.sh stop, logout, or SteamVR quits
  d1 --> d2: (R4.2) a way out hangs (as in R2, R3)
  d1 --> o1: G1: the desktop is down
  d2 --> q2: (R4.3) the next desktop starts the display: host_busy can't see the orphan
  q0 --> q1: (R2.1 R3.1) you connect it (ft-layout remote N start)
  q1 --> q2: (R2.2 R3.2) ft_remote_tick: the host free, start_stream
  q2 --> q3: (R2.3 R3.3) state live
  q2 --> q4: (R5) can't connect, or a 404: exit 1. A 404 that never clears loops every 30 s
  q3 --> q7: (R2.4 R3.4) the host or the network ends it
  q7 --> q8: (R3.5) LiStopConnection returns: state lost
  q7 --> q10: (R2.5) LiStopConnection never returns
  q8 --> q11: (R3.6) the decoder close or the HTTP call never returns
  q8 --> q9: it exits
  q9 --> q4: (fixed R1 e15b65f) reaped: only now may a new start go
  q4 --> q1: the back-off passes
  q2 --> q5: you disconnect it, or its settings change
  q3 --> q5: you disconnect it, or its settings change
  q5 --> q9: it exits in time
  q5 --> q6: its way out hangs
  q6 --> q9: (fixed slot leak e15b65f) SIGKILL, FT_REMOTE_QUIT_MS = 20 s
  q10 --> q5: only you: Connected off
  q11 --> q5: only you: Connected off
  q9 --> q0: reaped, and you had disconnected it
  h0 --> h1: live, the switch on: flock
  h1 --> h2: a fresh worn, not paused, no test flag: engage
  h2 --> h1: a fresh away or the switch off: release. Not fresh: drop
  h1 --> h5: the switch goes off and on, a worn answer waits
  h5 --> h1: (fixed H1 76121c7) dated from its send stamp: stale, drop, ask again
  h2 --> h3: someone at the computer presses the escape hotkey
  h3 --> h0: the stream ends: Stop(kDrop) keeps the escape and the marker
  h0 --> h4: (fixed H2 2c783dd) the next stream reads the marker, the headset went off 1.5 s+ and on
  h4 --> h1: the release goes before the first engage: marker removed
  h2 --> h6: (R2.5 R3.6) its way out hangs: drop sent, flock kept
  h6 --> h0: it dies: SIGKILL only if it was asked to end
  h2 --> h0: the stream ends: drop, the process exits
  f0 --> f1: you run worn on
  f1 --> f0: (fixed D 0c7eb9e) refused: a live stream, or an unconfirmed release left a flag
  f1 --> f2: the guard takes the locks, worn 1
  f2 --> f0: (fixed A C 37d0fbf) worn off: released, confirmed, then the flag goes
  f2 --> f3: (fixed F 1f485fe) the guard is stopped or killed: it releases, leaves the flag
  f3 --> f4: (fixed B bd606ce) a stream takes the freed lock: the flag stops the lease
  f4 --> f0: (fixed E 38d6257) the next command releases: the stream forgets its worn answers
  f2 --> o8: G8: the testbench fakes the wearer inside vrserver
  n0 --> n1: hostdev hello, each second while leasing
  n1 --> n0: hostbye, 3 s with no word (HOST_TIMEOUT), or the relay falls behind
  n1 --> o3: G3: host devices take roles and bindings like USB ones
