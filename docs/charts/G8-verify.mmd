  class lg13 xgroup
  state "The verify run (verify-frametop launch, guard, snapshot, cleanup, G8Verify.tla)" as td {
    t0: No run: RUN/verify-frametop.json free
    [*] --> t0
    t1: Run held: launch's doctor passed (not worn, no overrides or fakes left, no host-input stream), lease 30 min from the last launch, guard or snapshot
    t2: Driving: V guard && T ..., each T command runs drop_unsafe_worn first, then one request
    t3: Agent gone: a killed shell, a stalled approval prompt, the context ran out, no cleanup ran
    t4: Lease stale: older than 30 min, which only lets a new launch take it
    t5: Fakes left with nobody driving: overrides, the guard and its locks, the fake trackers
    t6: frame-testbench-mcp: stdio, one tool runs the CLI once, no network listener, no install or restart tool, its worn tool has no allow-host-input
  }
  state "Fake 1: the input proxy in vrserver (testbench/native, F20)" as pr {
    p0: Stock SteamVR: no drop-in, or the health check counts a failure (frog in steamvr-short-session-tracker), so this start runs without the proxy
    [*] --> p0
    p1: Drop-in 90-frame-testbench.conf: LD_PRELOAD interpose.cpp, RestartSec=30
    p2: Input proxy: wraps driver_cv.so, adds frame_testbench_left and right, control socket RUN/frame-testbench.sock (0600, peer uid checked)
    p3: Overrides held: worn on or off (proximity), head pose, HMD buttons, synthetic controllers, no timeout
  }
  state "Fake 2: the fake trackers (frame-testbench-fakes, fakes.py, docs/fake-trackers.md)" as fk {
    k0: Not running
    [*] --> k0
    k1: Running: RUN/frame-testbench-fakes.sock, stand-ins RUN/frametop-testbench/eye-server.mmap and frametop-eyes-gaze at 90 Hz, never the real /dev/shm files
    k2: Hands: marker RUN/frametop-testbench/hands at 2 Hz parks ft-hands (fresh 3 s), then fake hands and gestures in /run/user/UID/frametop-hands at 30 Hz
    k3: Waiting: ft-hands records for the Hand Recorder and doesn't park (hands_waiting)
    k4: Ended: close() publishes no hands, ends gestures as lost, takes the marker back out
    k5: Crashed: the stand-ins go stale (eyes 2 s, hands 3 s), the readers go back by themselves
    k6: Kept alive: nobody drives, status reads keep restarting the idle hour
    k7: record NAME: reads the real eye files and ft-hands' files (no images) into artifacts/recordings (0700), refuses while faking them
  }
  state "Fake 3: Frametop's own sockets (desktop.py, docs/desktop.md)" as dk {
    d0: Relay @frametop_relay: a testbench keyboard or mouse for one command (hostdev, hostev, hostbye), gone 3 s after its last word
    [*] --> d0
    d1: Pointer helper @ft_pointer_helper: state, overlays, measure, show, hide, recenter
    d2: ft-powerd @ft_powerd: the displays off or on, 2 s with no use counted
    d3: The 3D mouse's button left down
  }
  state "Fake 4: the fake-worn guard (hostinput.py, cli.py worn, FakeWornGuard.tla)" as gd {
    g0: No faked wearer: no RUN/frametop-fake-worn.json
    [*] --> g0
    g1: worn on refused: a live stream to an input host, or a flag naming no live guard (an unconfirmed release)
    g2: Guard holding: unit frametop-fake-worn-guard holds every frametop-input-HOST.lock, the flag names its pid, then worn 1 and the post-check
    g3: Guard gone, flag left: ExecStopPost after_guard releases the wearer, ft-stream reads the flag and sends no lease
    g4: Faked wearer left: the guard died in a proxy stall, nothing retries
    g5: allow-host-input: the flag says allow, no guard, only when the user allowed it in the session
  }
  state "F21 The recorders and the upload (recorder/, hands/rec, gaze/rec)" as rc {
    r0: A recorder window: ft-handrec with its panel @ft_handpanel, or ft-eyerec, one window, stays awake while recording
    [*] --> r0
    r1: Recording takes: ft-camd's ring for hands, the eye cameras for eyes
    r2: Exported: takes.py, SHA256SUMS and the manifest, eye chunks and health encrypted with age to recipients.txt, hand testing sessions to the maintainer's keys
    r3: Checking: validate.py errors stop it, a duplicate export is refused, a DRAFT text closes it
    r4: Uploading: whoami (not a read token), auth_check, the pull request opened first, upload_folder to refs/pr/N, marked open, recorded in session.json
    r5: On Hugging Face: DeeJanuz/frametop-hands, frametop-hands-test, frametop-eyes (gated)
    r6: Draft gate open on the real hand dataset
  }
  state "F22 Diagnostics (scripts/report.sh, report-watch.py, gaze-report.py, doctor.sh)" as dg {
    x0: report.sh: system, desktop, gaze, hands, voice, --watch 5 to 600 s, writes frametop-report-DATE.txt in the checkout, Bluetooth addresses and serials masked, nothing sent
    [*] --> x0
    x1: Live checks: gaze-report.py wakes the gaze service for about 20 s, the voice area takes 1 s of the mic for whisper and keeps only the word count
    x2: doctor.sh: ssh, distrobox, the container, free space, the taskbar, update-check.py, --mark-good records the versions
    x3: Logs: the journal per unit, screens.log (8 MB, then .1), /tmp/frametop-*.log, RUN/frametop-layout.log, RUN/frametop-remote-N.log, no telemetry leaves the Frame
  }
  state "The tour (tour/ft_tour.py)" as tr {
    u0: Not done: no ~/.local/state/frametop/tour.json at version 2
    [*] --> u0
    u1: Open: ft-tour --first-run at desktop start, or the menu, frunner, the dashboard, Input Settings
    u2: Done: tour.json written with how and when
  }
  state "Other groups" as og {
    o1: G1 Worn, pause and presence
    o2: G2 Desktop and panels
    o3: G3 Input and pointer
    o4: G4 Gaze
    o5: G5 Hands
    o6: G6 Remote displays and host input
  }
  t0 --> t1: V launch NAME, the claim under a flock
  t1 --> t2: T worn on, compositor awake, pose set, gaze look, hand set
  t2 --> t1: V snapshot (it guards too), the lease runs on
  t2 --> t0: V cleanup RUN, or V guard finding a wearer: displays on, T release, compositor auto, gaze mode back, the lock freed
  t2 --> t3: (V1.1) the agent dies mid-run
  t3 --> t4: (V1.2) 30 min on, the lease only goes stale
  t4 --> t5: (V1.3) nothing releases the overrides or stops the guard
  t5 --> o1: (V1.4) someone puts the headset on: a frozen head pose, or standby under worn off
  t5 --> t0: T release, V cleanup --force, or a SteamVR restart, by hand
  t4 --> t1: the next V launch, once cleanup cleared the leftovers
  t6 --> t2: each MCP tool runs the CLI
  p0 --> p1: testbench/install.sh install --restart, nobody in the headset
  p1 --> p2: vrserver dlopens driver_cv.so and gets the proxy
  p1 --> p0: a counted failure: the next start runs stock once, or uninstall --restart
  p2 --> p3: T worn, pose, hmd-button, controller: one JSON line each
  p3 --> p2: T release, worn physical, pose reset, controller reset
  p3 --> o1: G1: worn to SteamVR, the pointer helper, ft-powerd and the pause
  p3 --> o3: G3: synthetic controllers and HMD buttons as Frame input
  p3 --> t5: (V1.5) no expiry, worn_ wins over the real sensor
  k0 --> k1: gaze look, hand set or replay start it (systemd-run)
  k1 --> k2: hand set
  k2 --> k3: ft-hands records
  k3 --> k2: the recording ends, ft-hands parks
  k1 --> k4: release, the last fake released, SIGTERM, an hour idle
  k4 --> k0: files back out
  k1 --> k5: SIGKILL or a crash
  k5 --> k0: ft-gaze and ft-hands read the real files again
  k1 --> o4: G4: ft-gaze reads the stand-in while fresh, the gaze pointer and calibration's dots
  k2 --> o5: G5: ft-hands parked, cutouts, pinches and grips read the fake
  k1 --> k6: (V2.1) nobody drives, a status read every so often (a later doctor, an MCP status)
  k6 --> o4: (V2.2) fake gaze and parked hands stay for whoever puts the headset on
  k7 --> k1: replay NAME
  d0 --> o3: G3: a host device with the same roles, bindings and typing
  d0 --> d3: (V4.1) pointer mode: the testbench killed mid-drag, or the release read after hostbye
  d3 --> o3: (V4.2) the helper keeps the button down until the next click
  d1 --> o3: G3: the 3D mouse's cursor
  d2 --> o1: G1: the displays' power
  g0 --> g1: T worn on with a stream to an input host, or a flag with no live guard
  g0 --> g2: T worn on: start_guard, worn 1, the post-check
  g2 --> g0: (fixed A C D E F) worn off or physical, release: the wearer goes, then the flag, the guard lets go
  g2 --> g3: (fixed B) the guard killed or stopped: after_guard releases the wearer, the flag stays
  g3 --> g0: the next T command: drop_unsafe_worn releases, then clears the flag
  g3 --> g4: (V3.1) the proxy stalls through after_guard's 3 tries
  g4 --> g0: (V3.2) only the next T command, nothing on a timer
  g2 --> o6: G6: ft-stream finds the lock taken and the flag, no lease
  g0 --> g5: T worn on --allow-host-input
  g5 --> o6: G6: ft-stream leases while worn
  r0 --> r1: start a take
  r1 --> r2: export
  r2 --> r3: Upload
  r3 --> r4: valid, new, the texts final
  r4 --> r5: the pull request
  r3 --> r6: (V5.1) a hand text marked DRAFT again, FT_HANDREC_ALLOW_UPLOAD=1 set
  r6 --> r5: (V5.2) a draft-consent upload to DeeJanuz/frametop-hands
  r1 --> o5: G5: ft-camd's ring, ft-hands keeps tracking
  r1 --> o4: G4: the eye cameras
  x0 --> x1: --gaze, --voice
  x0 --> x3: reads the logs and the services' sockets
  x1 --> o4: G4: wake 20 on @ft_gazed
  u0 --> u1: the desktop starts
  u1 --> u2: close, skip or finish
  u2 --> u0: Show this tour at start, ft-tour --reset, a new TOUR_VERSION
  u1 --> o4: G4: Calibrate, Quick check (@ft_gazed)
  u1 --> o3: G3: frunner open (@ft_frunner)
  u1 --> o2: G2: spin next (@ft_screens)
