  {
   "id": "hand-size",
   "title": "Hand size",
   "requires": [],
   "go": "Hold",
   "quick": true,
   "intro": "First, your hand size: both hands up about 40 cm out, still.",
   "prompts": [
    {
     "text": "Both hands about 40 cm out, still|Palms toward you",
     "seconds": 6,
     "hands": "both",
     "distance": "mid",
     "switch": [
      {
       "at": 0.5,
       "to": "backs toward you",
       "text": "Both hands about 40 cm out, still|Backs toward you"
      }
     ]
    }
   ]
  },
  {
   "id": "play",
   "title": "Finger play",
   "intro": "Anything with your fingers, as long as they each do something different. The steps give ideas: there's no wrong way, so make it odd. Mostly palm toward you, near and far.",
   "prompts": [
    {
     "id": "play/piano-right",
     "hands": "right",
     "pose": "flat",
     "seconds": 18,
     "text": "Right hand, palm toward you, about 40 cm out. Play an invisible piano in the air:|each finger pressing on its own, fast and slow.",
     "switch": [
      {
       "at": 0.5,
       "to": "close to your face",
       "text": "Keep playing, the hand close now:|about a forearm's length from your eyes."
      }
     ]
    },
    {
     "id": "play/piano-left",
     "hands": "left",
     "pose": "flat",
     "seconds": 18,
     "text": "Left hand, palm toward you, about 40 cm out. Play an invisible piano in the air:|each finger pressing on its own, fast and slow.",
     "switch": [
      {
       "at": 0.5,
       "to": "close to your face",
       "text": "Keep playing, the hand close now:|about a forearm's length from your eyes."
      }
     ]
    },
    {
     "id": "play/count",
     "hands": "any",
     "pose": "open",
     "seconds": 18,
     "text": "Palm toward you. Count on your fingers in a strange order, raising and dropping them one at a time,|skipping around. Then two at a time that aren't next to each other.",
     "switch": [
      {
       "at": 0.5,
       "to": "the other hand"
      }
     ]
    },
    {
     "id": "play/wave",
     "hands": "any",
     "pose": "open",
     "distance": "near",
     "seconds": 16,
     "text": "Hand close, a forearm's length from your eyes, palm toward you.|Ripple the fingers in a wave, little to index and back, then flick each out from under the thumb.",
     "switch": [
      {
       "at": 0.5,
       "to": "the other hand"
      }
     ]
    },
    {
     "id": "play/shapes",
