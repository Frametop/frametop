     "pose": "open",
     "seconds": 16,
     "text": "Palm toward you, fingers moving the whole time: start at arm's length,|bring the hand all the way in to a forearm's length from your eyes and back out.",
     "switch": [
      {
       "at": 0.5,
       "to": "the other hand"
      }
     ]
    }
