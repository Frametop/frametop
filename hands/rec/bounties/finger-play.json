       "at": 0.5,
       "to": "the other hand"
      }
     ]
    },
    {
     "id": "play/turning",
     "hands": "any",
     "pose": "turn-in-out",
     "seconds": 16,
     "text": "Keep the fingers moving while you slowly turn the hand: palm toward you,|on its side, back toward you, and round again.",
     "switch": [
      {
       "at": 0.5,
       "to": "the other hand"
      }
     ]
    },
    {
     "id": "play/both",
     "hands": "both",
     "seconds": 16,
     "text": "Both hands, palms toward you, each doing its own thing:|one playing piano while the other counts, or anything else.",
     "switch": [
      {
       "at": 0.5,
       "to": "hands closer to your face"
      }
     ]
    },
    {
     "id": "play/reach",
