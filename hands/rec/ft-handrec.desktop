[Desktop Entry]
Type=Application
Name=Frametop Hand Recorder
GenericName=Hand recorder for Frametop's hand tracking
Comment=Record your hands for Frametop's hand tracking: bounty rounds and full sessions for its hand dataset, testing sessions to show what goes wrong
Exec=@REPO@/hands/rec/ft-handrec
Icon=camera-video
Categories=Utility;
# Not in SteamVR's Launch a program list (Steam runs in gamescope): it's in the Frametop menu (menu/ft-menu.desktop).
NotShowIn=gamescope;
X-Frametop-Menu=tools
Keywords=hands;hand tracking;dataset;record;frametop;
