#!/usr/bin/env bash
# Called after "Hey Scarlet ..." with the transcribed command as $1.
# Replace this with a call into the assistant. Runs as your user, no shell interpolation of $1.
set -euo pipefail
text="$1"
log_dir="${XDG_STATE_HOME:-$HOME/.local/state}/scarlet-voice"
mkdir -p "$log_dir"
printf '%s\t%s\n' "$(date -Is)" "$text" >> "$log_dir/commands.log"

# Built-in example: "Hey Scarlet, type hello world" types into the focused field.
shopt -s nocasematch
if [[ "$text" =~ ^(type|dictate)[[:space:],:]+(.*)$ ]]; then
    exec "$(dirname "$0")/../scarletctl" type "${BASH_REMATCH[2]}"
fi
