[Desktop Entry]
Type=Application
Name=Frametop Input Settings
GenericName=Mouse and keyboard settings for the 3D pointer
Comment=Choose and map Bluetooth mice and keyboards for the SteamVR 3D pointer
Exec=@REPO@/input-settings/ft-input-settings
Icon=input-mouse
Categories=Settings;HardwareSettings;
# Not in SteamVR's Launch a program list (Steam runs in gamescope): it's in the Frametop menu (menu/ft-menu.desktop).
NotShowIn=gamescope;
X-Frametop-Menu=settings
Keywords=mouse;pointer;bluetooth;keyboard;steamvr;frametop;
