#!/usr/bin/env python3
"""ft-textinput: Frametop's input method, which tells the input relay when a text field
on the desktop has keyboard focus, and types the characters the desktop's layout has no key for.

KWin starts it (--inputmethod, from session/frametop-session.sh) and activates it
whenever the focused app enables text input on a field (text-input v1/v2/v3: Qt, GTK,
and Firefox apps do; Xwayland apps and most Electron apps don't). This only passes that
on: "textfield 1" or "textfield 0" to the input relay (@frametop_relay), which opens or
closes Frametop's keyboard (Full Keyboard, through ft-screens), depending on the keyboard setting
in Frametop Input Settings. Typing reaches the app as key presses on ft-screens' seat, except
a character the desktop's keyboard layout has no key for (ą on a US layout), from Full Keyboard
or dictation: the relay sends it here as "commit TEXT", and this commits it to the focused text
field (zwp_input_method_context_v1.commit_string). Only those characters pass through here,
and they aren't logged. "commit" is taken only from the relay's own name (@frametop_relay) and
from this user, on an unnamed (autobound) socket the relay learns from our "textfield" reports,
so no other process can claim a name and receive typing. In apps without text input (Xwayland,
most Electron apps) no field activates this, and the relay drops such characters as before.

Speaks the Wayland wire protocol itself (zwp_input_method_v1 only), so it needs nothing
but Python on the SteamOS host.
"""
import os
import select
import socket
import struct
import sys

RELAY = "\0frametop_relay"
DISPLAY, REGISTRY, INPUT_METHOD = 1, 2, 3  # our object ids
CREDS = struct.Struct("=iII")  # SCM_CREDENTIALS: pid, uid, gid


def string(text):
    data = text.encode() + b"\0"
    return struct.pack("=I", len(data)) + data + b"\0" * (-len(data) % 4)


def read_string(body, at):
    """(text, offset after it) for a string argument at `at`."""
    (length,) = struct.unpack_from("=I", body, at)
    text = body[at + 4:at + 4 + length - 1].decode(errors="replace")
    return text, at + 4 + length + (-length % 4)


def main():
    fd = os.environ.pop("WAYLAND_SOCKET", None)
    if fd is None:
        sys.exit("ft-textinput: no WAYLAND_SOCKET (KWin starts this as its input method)")
    conn = socket.socket(fileno=int(fd))
    relay = socket.socket(socket.AF_UNIX, socket.SOCK_DGRAM | socket.SOCK_NONBLOCK)
    relay.bind("")  # autobind: an address the relay learns from our reports
    relay.setsockopt(socket.SOL_SOCKET, socket.SO_PASSCRED, 1)

    def request(obj, opcode, payload=b""):
        conn.sendall(struct.pack("=II", obj, (8 + len(payload)) << 16 | opcode) + payload)

    def report(on):
        try:
            relay.sendto(f"textfield {int(on)}".encode(), RELAY)
        except OSError:
            pass  # the relay isn't running

    def commit(text):
        """Commit text to the text field activated last, with its latest commit_state serial."""
        if contexts:
            context, serial = next(reversed(contexts.items()))
            request(context, 1, struct.pack("=I", serial) + string(text))  # commit_string

    def from_relay():
        while True:
            try:
                data, anc, _, addr = relay.recvmsg(4096, socket.CMSG_SPACE(CREDS.size))
            except BlockingIOError:
                return
            uid = next((CREDS.unpack(d[:CREDS.size])[1] for level, kind, d in anc
                        if level == socket.SOL_SOCKET and kind == socket.SCM_CREDENTIALS), None)
            if addr in (RELAY, RELAY.encode()) and uid == os.getuid() and data.startswith(b"commit "):
                commit(data[len(b"commit "):].decode(errors="replace"))

    request(DISPLAY, 1, struct.pack("=I", REGISTRY))  # wl_display.get_registry
    contexts = {}  # KWin makes one per activation: context id -> its latest commit_state serial
    buf = b""
    while True:
        # KWin's events go first, so a commit uses the serial of a commit_state that came before it.
        if conn not in select.select([conn, relay], [], [])[0]:
            from_relay()
            continue
        data = conn.recv(65536)
        if not data:
            return  # KWin went away
        buf += data
        while len(buf) >= 8:
            obj, word = struct.unpack_from("=II", buf)
            size, opcode = word >> 16, word & 0xFFFF
            if size < 8 or len(buf) < size:
                break
            body, buf = buf[8:size], buf[size:]
            if obj == DISPLAY and opcode == 0:  # error
                bad, code = struct.unpack_from("=II", body)
                message, _ = read_string(body, 8)
                sys.exit(f"ft-textinput: Wayland error {code} on object {bad}: {message}")
            elif obj == REGISTRY and opcode == 0:  # global
                (name,) = struct.unpack_from("=I", body)
                interface, _ = read_string(body, 4)
                if interface == "zwp_input_method_v1":
                    request(REGISTRY, 0, struct.pack("=I", name) + string(interface) + struct.pack("=II", 1, INPUT_METHOD))
            elif obj == INPUT_METHOD and opcode == 0:  # activate: a text field has focus
                contexts[struct.unpack_from("=I", body)[0]] = 0
                report(True)
            elif obj == INPUT_METHOD and opcode == 1:  # deactivate: it lost focus
                (context,) = struct.unpack_from("=I", body)
                if context in contexts:
                    del contexts[context]
                    request(context, 0)  # zwp_input_method_context_v1.destroy
                report(bool(contexts))
            elif obj in contexts and opcode == 4:  # commit_state: the serial a commit names
                contexts[obj] = struct.unpack_from("=I", body)[0]
            # Everything else (the contexts' surrounding text, content type, ...) is unused.


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        pass
