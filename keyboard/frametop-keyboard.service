# Template: the installer replaces @REPO@ with the repo path on the Frame.
[Unit]
Description=Frametop keyboard: Full Keyboard for Steam Frame, by TaiKeid, hosted by Frametop (keyboard/FRAMETOP.md)
Documentation=file://@REPO@/keyboard/FRAMETOP.md https://github.com/TaiKeid/steam-frame-full-keyboard
# Needs SteamVR's IPC; it starts and stops with SteamVR.
After=steamvr.service frametop-input-relay.service
PartOf=steamvr.service
Requisite=steamvr.service
# A keyboard that keeps failing stops being restarted after 5 tries in 2 minutes.
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
# SteamOS's Mesa settings, as Full Keyboard's own startup unit has them.
EnvironmentFile=-/usr/share/deckard/mesavars.sh
# ft-kbhost runs on the host and starts Full Keyboard's release (keyboard/build/release) in
# hosted mode. A standalone copy that's running is asked to quit by the keyboard itself.
ExecStart=/usr/bin/python3 -I @REPO@/keyboard/host/ft-kbhost
# Quitting it from its own panel exits with 3, and a release without hosted protocol 1 with 4:
# either way it stays closed until SteamVR starts again, or until the relay's Open/close keyboard
# action starts it (input/kb_revive.py).
SuccessExitStatus=3
RestartPreventExitStatus=3 4
Restart=on-failure
RestartSec=3
TimeoutStopSec=8

[Install]
WantedBy=steamvr.service
