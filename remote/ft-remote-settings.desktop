[Desktop Entry]
Type=Application
Name=Frametop Remote Access
GenericName=VNC access to the VR desktop
Comment=See and use the Frametop desktop from another computer on your tailnet
Exec=@REPO@/remote/ft-remote-settings
Icon=preferences-desktop-remote-desktop
Categories=Settings;Network;
# Not in SteamVR's Launch a program list (Steam runs in gamescope): it's in the Frametop menu (menu/ft-menu.desktop).
NotShowIn=gamescope;
X-Frametop-Menu=settings
Keywords=vnc;remote;desktop;tailscale;screen sharing;frametop;
