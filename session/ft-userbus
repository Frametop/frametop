#!/bin/sh
# The user's systemd tools and podman inside the Frametop desktop (DEE-327, issue 98). The
# desktop runs with its own XDG_RUNTIME_DIR ($XDG_RUNTIME_DIR/frametop), D-Bus
# (dbus-run-session), config (~/.config/frametop) and state, which its apps need: KWin's
# Wayland socket, the portals and Plasma's services are there. The user's systemd isn't, so
# `systemctl --user` in a terminal here couldn't connect, and podman looked for its running
# containers under the desktop's runtime folder, asked the desktop's bus for a cgroup, and
# missed ~/.config/containers.
#
# frametop-session.sh links systemctl, systemd-run and podman to this script in the desktop's
# own bin folder, first on its PATH (so distrobox finds this podman too). Run under one of
# those names, it runs /usr/bin's with the user's real runtime folder and session bus and
# without the desktop's config and state folders, as a login shell has them. Only these tools
# get them: the shell and the apps it starts keep the desktop's. FT_USERBUS_BIN is for the
# tests.
uid=$(id -u)
export XDG_RUNTIME_DIR=/run/user/"$uid"
export DBUS_SESSION_BUS_ADDRESS=unix:path=/run/user/"$uid"/bus
unset XDG_CONFIG_HOME XDG_STATE_HOME
exec "${FT_USERBUS_BIN:-/usr/bin}/${0##*/}" "$@"
