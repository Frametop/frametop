+// Frametop host input (Frametop's docs/host-input.md): the host lends its own keyboard and mouse
+// while the client renews a lease. LiSendFrametopHostInputLease sends a lease packet (type
+// 0x3005, at most LI_FRAMETOP_HOST_INPUT_MAX_LEASE bytes) reliably on a channel of its own, with
+// the same results as LiSendMicrophoneOpusData. The callback gets each 0x3004 payload from the
+// host on the control stream's receive thread, only from an encrypted control stream; it must
+// return quickly. Set it before LiStartConnection.
+#define LI_FRAMETOP_HOST_INPUT_MAX_LEASE 16
+typedef void(*FrametopHostInputCallback)(const unsigned char* data, int length);
+void LiSetFrametopHostInputCallback(FrametopHostInputCallback callback);
+int LiSendFrametopHostInputLease(const unsigned char* payload, int length);
