+// Frametop: host input leases on a channel of their own, like the microphone.
+#define CTRL_CHANNEL_HOST_INPUT 0x08
+
+void LiSetFrametopHostInputCallback(FrametopHostInputCallback callback) {
+    frametopHostInputCallback = callback;
+}
+
+int LiSendFrametopHostInputLease(const unsigned char* payload, int length) {
+    if (payload == NULL || length <= 0 || length > LI_FRAMETOP_HOST_INPUT_MAX_LEASE) {
+        return -2;
+    }
+
+    // Never in the clear, as with the microphone.
+    if (AppVersionQuad[0] < 5 || !IS_SUNSHINE() || !encryptedControlStream || peer == NULL || stopping) {
+        return -1;
+    }
+
+    if (!sendMessageAndForget(0x3005, (short)length, payload, CTRL_CHANNEL_HOST_INPUT, ENET_PACKET_FLAG_RELIABLE, false)) {
+        return -3;
+    }
+
+    return 0;
+}
+
