+// Frametop: the microphone's own channel, so a resent packet only holds up the microphone.
+#define CTRL_CHANNEL_MICROPHONE 0x07
+
+int LiSendMicrophoneOpusData(const unsigned char* opusData, int opusLength) {
+    unsigned char payload[4 + LI_MICROPHONE_MAX_OPUS_BYTES];
+
+    if (opusData == NULL || opusLength <= 0 || opusLength > LI_MICROPHONE_MAX_OPUS_BYTES) {
+        return -2;
+    }
+
+    // Never in the clear: only Sunshine-based hosts with the encrypted control stream.
+    if (AppVersionQuad[0] < 5 || !IS_SUNSHINE() || !encryptedControlStream || peer == NULL || stopping) {
+        return -1;
+    }
+
+    payload[0] = (unsigned char)(microphoneSequence >> 8);
+    payload[1] = (unsigned char)microphoneSequence;
+    payload[2] = 1;
+    payload[3] = 0;
+    memcpy(&payload[4], opusData, opusLength);
+    microphoneSequence++;
+
+    if (!sendMessageAndForget(0x3003, (short)(4 + opusLength), payload, CTRL_CHANNEL_MICROPHONE, ENET_PACKET_FLAG_RELIABLE, false)) {
+        return -3;
+    }
+
+    return 0;
+}
