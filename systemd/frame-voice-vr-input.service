[Unit]
Description=frame-voice controller push-to-talk
# No After=steamvr.service: default.target is ordered after its wants and steamvr after
# the graphical session, so that would be an ordering cycle. The script retries until
# SteamVR is up.
After=frame-voice.service

[Service]
ExecStart=%h/Desktop/Projects/frame-voice/.venv/bin/python %h/Desktop/Projects/frame-voice/frame_voice_vr_input.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target steamvr.service
