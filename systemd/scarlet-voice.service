[Unit]
Description=scarlet-voice dictation and wake word daemon
Wants=scarlet-whisper.service pipewire.service
After=scarlet-whisper.service pipewire.service
# SteamVR opens input devices only at startup, and gamescope gets keyboard input through
# SteamVR, so the typing keyboard must exist before SteamVR starts.
Before=steamvr.service

[Service]
# READY=1 is sent after the virtual keyboard exists.
Type=notify
NotifyAccess=main
ExecStart=%h/Desktop/Projects/scarlet-voice/.venv/bin/python %h/Desktop/Projects/scarlet-voice/scarlet_voice.py
Restart=on-failure
RestartSec=2
# systemd keeps the virtual keyboard's fd across restarts, so SteamVR keeps the same device.
# Clear with: systemctl --user clean --what=fdstore scarlet-voice
FileDescriptorStoreMax=1
FileDescriptorStorePreserve=yes

[Install]
WantedBy=default.target steamvr.service
