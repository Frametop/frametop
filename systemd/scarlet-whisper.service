[Unit]
Description=whisper.cpp server for scarlet-voice

[Service]
# The Gamescope WSI layer asserts on compute-only Vulkan devices; whisper needs no swapchain.
Environment=DISABLE_GAMESCOPE_WSI=1
ExecStart=%h/Desktop/Projects/scarlet-voice/vendor/whisper.cpp/build/bin/whisper-server -m %h/Desktop/Projects/scarlet-voice/models/ggml-small.en-q5_1.bin --host 127.0.0.1 --port 8178 -t 3 -fa
Restart=on-failure
Nice=5

[Install]
WantedBy=default.target
