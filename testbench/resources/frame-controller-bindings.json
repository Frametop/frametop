            "touch": {
              "output": "/actions/observe/in/left_dpad_up_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/dpad_right",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/observe/in/left_dpad_right_click"
            },
            "touch": {
              "output": "/actions/observe/in/left_dpad_right_touch"
            }
          }
        },
