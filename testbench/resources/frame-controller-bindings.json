{
  "controller_type": "frame_controller",
  "name": "Frame testbench independent input observation",
  "description": "Original bindings for public OpenVR action readback. Reserved and internal inputs may remain inactive.",
  "bindings": {
    "/actions/observe": {
      "sources": [
        {
          "path": "/user/hand/left/input/system",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/observe/in/left_system_click"
            },
            "touch": {
              "output": "/actions/observe/in/left_system_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/bumper",
          "mode": "button",
          "inputs": {
            "click": {
              "output": "/actions/observe/in/left_bumper_click"
            },
            "touch": {
              "output": "/actions/observe/in/left_bumper_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/trigger",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/observe/in/left_trigger_click"
            },
            "touch": {
              "output": "/actions/observe/in/left_trigger_touch"
            },
            "pull": {
              "output": "/actions/observe/in/left_trigger_value"
            }
          }
        },
        {
          "path": "/user/hand/left/input/grip",
          "mode": "trigger",
          "inputs": {
            "click": {
              "output": "/actions/observe/in/left_grip_click"
            },
            "touch": {
              "output": "/actions/observe/in/left_grip_touch"
            },
            "pull": {
              "output": "/actions/observe/in/left_grip_value"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbstick",
          "mode": "joystick",
          "inputs": {
            "click": {
              "output": "/actions/observe/in/left_thumbstick_click"
            },
            "touch": {
              "output": "/actions/observe/in/left_thumbstick_touch"
            },
            "position": {
              "output": "/actions/observe/in/left_thumbstick_position"
            }
          }
        },
        {
          "path": "/user/hand/left/input/thumbrest",
          "mode": "button",
          "inputs": {
            "touch": {
              "output": "/actions/observe/in/left_thumbrest_touch"
            }
          }
        },
        {
          "path": "/user/hand/left/input/view",
