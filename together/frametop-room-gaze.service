# Template: the installer replaces @REPO@ with the repo path on the Frame.
[Unit]
Description=Frametop Together: where you look, for the room, only while you share it
Documentation=file://@REPO@/together/README.md
After=frametop-together.service
PartOf=frametop-together.service

[Service]
# On the host: Python's standard library and conf/ftipc.py.
ExecStart=/usr/bin/python3 @REPO@/together/ft-roomgaze
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
