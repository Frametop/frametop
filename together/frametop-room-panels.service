# Template: the installer replaces @REPO@ with the repo path on the Frame.
[Unit]
Description=Frametop Together: the room's shared panels on this headset
Documentation=file://@REPO@/together/README.md
After=frametop-together.service
PartOf=frametop-together.service

[Service]
# On the host: Python's standard library and conf/ftipc.py. Ending it takes the room's panels
# away and stops every share.
ExecStart=/usr/bin/python3 @REPO@/together/ft-roompanels
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
