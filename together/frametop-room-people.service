# Template: the installer replaces @REPO@ with the repo path on the Frame.
[Unit]
Description=Frametop Together: the other people in the room, and where you are in it
Documentation=file://@REPO@/avatar/README.md
After=frametop-together.service steamvr.service
PartOf=frametop-together.service

[Service]
# ft-avatars is the mirror's program too, so only the one started with --room is cleaned up.
# Without SteamVR it ends at once and is tried again.
ExecStartPre=-/usr/bin/pkill -f "ft-avatars --room( |$$)"
ExecStart=@REPO@/scripts/in-box @REPO@/screens/build/ft-avatars --room --status 60
ExecStopPost=-/usr/bin/pkill -f "ft-avatars --room( |$$)"
Restart=on-failure
RestartSec=10
TimeoutStopSec=5
