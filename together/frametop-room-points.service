# Template: the installer replaces @REPO@ with the repo path on the Frame.
[Unit]
Description=Frametop Together: where the others point, on the panels they point at
Documentation=file://@REPO@/together/README.md
After=frametop-together.service
PartOf=frametop-together.service

[Service]
# In the container it was built in. It joins SteamVR only when someone points at a panel this
# Frame shows, and doesn't start it or keep it running.
ExecStartPre=-/usr/bin/pkill -x ft-roompoints
ExecStart=@REPO@/scripts/in-box @REPO@/together/build/ft-roompoints
ExecStopPost=-/usr/bin/pkill -x ft-roompoints
Restart=on-failure
RestartSec=3
TimeoutStopSec=5
