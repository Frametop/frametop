#!/usr/bin/env python3
"""Control the frame-voice daemon: frame-voice-ctl toggle|start|stop|cancel|status|type TEXT|wake [on|off|toggle]|events"""
import os
import socket
import sys
from pathlib import Path

# Not $XDG_RUNTIME_DIR: Frametop's desktop points it at its own directory.
path = Path(f"/run/user/{os.getuid()}") / "frame-voice/control.sock"
if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help"):
    sys.exit(__doc__)
sock = socket.socket(socket.AF_UNIX)
try:
    sock.connect(str(path))
except OSError as err:
    sys.exit(f"frame-voice not reachable at {path}: {err}")
sock.sendall((" ".join(sys.argv[1:]) + "\n").encode())
f = sock.makefile()
if sys.argv[1] == "events":
    for line in f:
        print(line, end="", flush=True)
else:
    print(f.readline(), end="")
